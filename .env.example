# ── Server ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/provision_store?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/provision_store_test?schema=public

# ── Auth ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
# Use `none` when the web app and API are on different sites (e.g. Vercel + Render).
# Browsers then also require COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# ── Seed admin (first boot only) ───────────────────────────────────
SEED_ADMIN_NAME=Store Owner
SEED_ADMIN_EMAIL=admin@provisionstore.local
SEED_ADMIN_PASSWORD=
SEED_STORE_NAME=Smart Provision Store
SEED_STORE_GSTIN=33ABCDE1234F1Z5
SEED_STORE_STATE_CODE=33

# ── Uploads / storage ──────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ── Jobs ───────────────────────────────────────────────────────────
ENABLE_CRON=true
